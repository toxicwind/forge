# ─────────────────────────────────────────────────────────────────────────
# estate/.gitignore — GENERATED FILE, DO NOT HAND-EDIT
#
# Source of truth:  ops/gitignore/manifest.json
# Regenerate:       bun ops/bin/gitignore-sync.ts
# Verify drift:     bun ops/bin/gitignore-sync.ts --check
