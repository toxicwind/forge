SingletonLock
SingletonCookie
.lock

# tau runtime state: transcripts, vendored plugin caches, compiled natives.
# Regenerated on demand; config/tau/agent/config.yml itself stays tracked.
config/tau/agent/sessions/
config/tau/sessions/
config/tau/plugins/cache/
config/tau/natives/
# Attached-image blob store. Regenerated per screenshot/attachment, and 118
# of these were committed before this rule existed -- they stay tracked (a
# tracked file is never ignored), but new blobs no longer get staged.
config/tau/agent/blobs/
# Launcher and service runtime state, rewritten on every start.
config/tau/.launcher.lock
pitchfork.d/storage/
pitchfork.d/.qdrant-initialized

# Fleet message spool, written per-message by the squawk bus.
hatch/agents/*/squawk-root/

