# ── NativeLink runtime state (2026-10-19) ───────────────────────────────
# NativeLink CAS/AC content stores and worker scratch live under var/runtime
# (already covered by `var/` in 10-layout-tiers). What's new: bazel symlinks
# and local rc fragments that any REAPI-connected project materializes.
# Content-addressed cache output, never source of truth. Root-anchored:
# the tau repo tracks its own bazel/ rules dir (no dash), and nested repos
# carry their own .gitignore for these.
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-*
/user.bazelrc

# ── Standing audit artifacts (2026-10-15) ───────────────────────────────
# Skills may keep versioned reports. The template layers' unanchored
# `*.log` (Node/bun/Django/VS — 4 occurrences) silently swallows raw audit
# output at any depth; re-include skill reports so audits stay reproducible.
# anchored: root-level dirs only — an unanchored `packages/**` would also
# re-include any nested `x/packages/` tree vendored under other subrepos.
!/skills/**/reports/**

# ── Estate workspace packages (2026-10-15) ──────────────────────────────
# Root package.json declares workspaces: packages/*, but the VisualStudio
# template layer ships **/[Pp]ackages/* which swallowed the whole tree —
# 14 files in packages/Estate-utils were silently unstaged. Re-include,
# then re-ignore the build artifacts the negation would otherwise
# resurrect (these negations come after the template layers).
!/packages/**
/packages/**/node_modules/
/packages/**/dist/
/packages/**/build/
/packages/**/.cache/
/packages/**/*.tsbuildinfo

# ── Config ownership ────────────────────────────────────────────────────
# estate/.env IS the runtime config SSOT (ports, model names, stream tuning)
# and is tracked on purpose. Secrets never are.
!.env
# `*.env` (unanchored, from the dotenv template layer) swallows every *.env at
# any depth — including config/ports.env. That file is the port SSOT that mise
# injects via env._.file; gitignoring it makes the SSOT unreproducible from a
# clone. Re-include it explicitly, the same way .env is re-included above.
!config/ports.env
.env.local
.secrets

# config/.secrets.json is a generated index of /home/toxic/.secrets and carries
# the plaintext `value` for every entry, so it is a secret file, not config.
# The .super-bak-* snapshots are the same content plus older keys. Both are
# already on origin/main; see docs/gemini-key-conventions.md for rotation.
.secrets.json
.secrets.json.*
.secrets.super-bak-*
.secrets.bak-*

# ~/.config is a symlink into ranch/shell/ii/dots/.config — the estate owns
# it, but it lives in the ranch repo. Nothing extra to ignore here.

# nested checkouts that were never meant to be tracked
hatch/agents/ember/readme-op/work/

# Upstream template rules are unanchored and match at any depth, which
# silently swallowed source trees. Re-include them; these directories are
# ours, not Python/VisualStudio build output.
#   Python.gitignore ships `lib/`, VisualStudio.gitignore ships `**/[Bb]in/*`.
!**/lib/
!skills/**/bin/
!ops/bin/**
!projects/**/bin/

# Security boundaries (git-mutator): credential material is never committed
credentials.json
*.key
*.pem
.bak.

# non-secret hodos route; secrets remain in ignored hodos.env
!config/hodos-ssot/route.env

# config/environment.d/ — purged stale configs (2026-10-12); directory is
# managed outside git, ignore it to prevent accidental tracking.
config/environment.d/

# 50-secrets — credential material is never committed.
# LAST layer on purpose: no earlier negation can re-include anything below.
# Enforced twice: here (untracked files) and by the global gitleaks hooks in
# ops/git-hooks/ (anything staged or pushed, in every repo on the box).
.env
.env.*
!.env.example
*.env
!.env
!.envrc
# re-ignore credential envs the !.env negation would resurrect at depth:
config/tau/.env
config/**/.env
!config/ports.env
!config/hodos-ssot/route.env
.secrets
.secrets.*
.corral-*-env
*keys_raw*
nvapi_audit_summary.json
auth.json
*.token
id_rsa*
id_ed25519*
*.p12
*.pfx

