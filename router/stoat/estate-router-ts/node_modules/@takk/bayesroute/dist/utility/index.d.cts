import { a as UtilityScale, U as UtilityWeights, A as ArmRecord } from '../types-BBe9hxUs.cjs';

/**
 * The multi-objective expected utility.
 *
 * A router does not optimize a single metric; it trades quality against latency and cost. The utility
 * is a weighted combination where higher quality is rewarded and latency and cost are penalized after
 * being normalized onto the quality scale by reference values. The same function scores a sampled draw
 * (Thompson sampling) and a posterior mean (the greedy incumbent), so exploration and exploitation are
 * measured on one ruler.
 *
 * @packageDocumentation
 */

/** Default weights: quality dominates, latency and cost each carry a quarter of its weight. */
declare const DEFAULT_WEIGHTS: UtilityWeights;
/** Default reference scales: one second of latency and one thousand cost units map to one penalty unit. */
declare const DEFAULT_SCALE: UtilityScale;
/** Throw unless the weights are finite and non-negative with at least one positive weight. */
declare function assertWeights(w: UtilityWeights): void;
/** Throw unless the reference scales are finite and strictly positive. */
declare function assertScale(s: UtilityScale): void;
/**
 * The expected utility of a single (quality, latency, cost) point. Quality is a probability in [0, 1];
 * latency is milliseconds; cost is in the consumer's own unit. Higher is better.
 */
declare function expectedUtility(quality: number, latencyMs: number, cost: number, weights?: UtilityWeights, scale?: UtilityScale): number;
/** The expected utility of an arm computed from its posterior means, the greedy score. */
declare function meanUtility(record: ArmRecord, weights?: UtilityWeights, scale?: UtilityScale): number;

export { DEFAULT_SCALE, DEFAULT_WEIGHTS, UtilityScale, UtilityWeights, assertScale, assertWeights, expectedUtility, meanUtility };
