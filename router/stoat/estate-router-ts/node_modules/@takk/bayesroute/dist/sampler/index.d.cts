import { R as Rng } from '../rng-Bx4ZsBo1.cjs';
import { A as ArmRecord, U as UtilityWeights, a as UtilityScale, n as ArmDraw, R as RouteDecision } from '../types-BBe9hxUs.cjs';

/**
 * The Thompson sampler, the heart of the router.
 *
 * For each query the sampler draws one value from every arm's three posteriors, scores each arm by the
 * multi-objective expected utility, and routes to the arm whose draw scored highest. Because the draws
 * come from the posteriors, an arm that is rarely tried but might be excellent still gets its turn in
 * proportion to the probability it is actually best, which is what gives Thompson sampling its bounded
 * regret. The greedy incumbent, the arm with the highest posterior-mean utility, is reported alongside
 * so the safe-exploration policy can decide whether the explored pick is allowed.
 *
 * @packageDocumentation
 */

/** Draw one Thompson sample for a single arm and score its expected utility. */
declare function sampleArm(record: ArmRecord, weights?: UtilityWeights, scale?: UtilityScale, rng?: Rng): ArmDraw;
/** The greedy incumbent: the arm with the highest posterior-mean utility. Throws on an empty set. */
declare function greedyIncumbent(arms: ReadonlyArray<ArmRecord>, weights?: UtilityWeights, scale?: UtilityScale): ArmRecord;
/**
 * Route one query by Thompson sampling over the arms. Returns the chosen arm, every arm's draw sorted
 * by utility (highest first), and whether the pick differs from the greedy incumbent (explored).
 */
declare function thompsonRoute(arms: ReadonlyArray<ArmRecord>, weights?: UtilityWeights, scale?: UtilityScale, rng?: Rng): RouteDecision;

export { greedyIncumbent, sampleArm, thompsonRoute };
