import { A as ArmRecord, c as ArmPrior, D as DecayOptions } from '../types-BBe9hxUs.cjs';

/**
 * Time-decay of evidence.
 *
 * Models drift: a provider silently deprecates a checkpoint, a domain shifts, last quarter's latency no
 * longer predicts this quarter's. Decay relaxes every posterior back toward its prior as time passes, so
 * stale evidence loses weight and the router re-explores. At each step the pseudo-counts above the prior
 * are scaled by `0.5 ^ (elapsed / halfLifeMs)`; one half-life halves the accumulated evidence. The raw
 * observed counts are preserved as history, only the posteriors are relaxed.
 *
 * @packageDocumentation
 */

/** The retention factor in (0, 1] for an elapsed time and half-life. */
declare function retention(elapsedMs: number, halfLifeMs: number): number;
/**
 * Return a copy of the arm with its posteriors relaxed toward the prior for the time elapsed between
 * its last observation and `now`. The observed counts are kept; `lastObservedAt` advances to `now` so
 * decay is not applied twice. A non-positive elapsed time returns the record unchanged.
 */
declare function decayArm(record: ArmRecord, prior: ArmPrior, options: DecayOptions, now: number): ArmRecord;

export { DecayOptions, decayArm, retention };
