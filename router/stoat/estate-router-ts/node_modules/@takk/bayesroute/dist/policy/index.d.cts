import { m as SafeExplorationPolicy, R as RouteDecision, A as ArmRecord, U as UtilityWeights, a as UtilityScale } from '../types-BBe9hxUs.cjs';

/**
 * The safe-exploration policy.
 *
 * Thompson sampling explores by design, but unbounded exploration can route a production query to an
 * arm that is probably worse, a regression the caller never agreed to. The policy caps that risk: an
 * explored pick is allowed when the arm is still under-explored (fewer than `minPulls` observations),
 * or when its posterior-mean utility is within `maxRegretMargin` of the greedy incumbent. Otherwise the
 * router falls back to the incumbent. This keeps the long-run regret bounded while never letting a
 * single decision stray too far from the best known arm.
 *
 * @packageDocumentation
 */

/** A sensible default: arms under ten pulls explore freely, otherwise stay within 0.05 utility of best. */
declare const DEFAULT_SAFE_EXPLORATION: SafeExplorationPolicy;
/** Throw unless the policy parameters are finite and non-negative. */
declare function assertSafeExploration(policy: SafeExplorationPolicy): void;
/**
 * Apply the safe-exploration guard to a Thompson decision. When the explored pick is neither
 * under-explored nor within the regret margin of the incumbent, fall back to the incumbent and clear
 * the explored flag. A greedy (non-explored) decision is returned unchanged.
 */
declare function applySafeExploration(decision: RouteDecision, arms: ReadonlyArray<ArmRecord>, weights?: UtilityWeights, scale?: UtilityScale, policy?: SafeExplorationPolicy): RouteDecision;

export { DEFAULT_SAFE_EXPLORATION, SafeExplorationPolicy, applySafeExploration, assertSafeExploration };
