declare function observeArm(record: ArmRecord, outcome: Outcome, at: number): ArmRecord;
/** Produce a calibrated point-and-interval summary of one arm under the given weights and scale. */
declare function armSummary(record: ArmRecord, weights?: UtilityWeights, scale?: UtilityScale, level?: number): ArmSummary;

