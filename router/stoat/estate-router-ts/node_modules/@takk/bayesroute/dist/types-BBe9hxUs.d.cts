/**
 * Shared types for @takk/bayesroute.
 *
 * BayesRoute is exact Bayesian inference applied to model routing, not a heuristic. Every arm is a
 * (model, domain) pair carrying three conjugate posteriors: a Beta over the probability of an
 * acceptable output (quality), and two Gamma-Exponential posteriors over response time (latency) and
 * token usage (cost). For each query the router samples one value from every posterior, scores the
 * arms by expected utility, and routes to the best draw (Thompson sampling). After the real outcome
 * is observed the posteriors are updated in closed form. Every type here describes one of those
 * posteriors, the evidence you feed them, or what the router returns.
 *
 * @packageDocumentation
 */
/** A clock returning epoch milliseconds. Inject one to keep audit timestamps and decay testable. */
type Clock = () => number;
/** A Beta(alpha, beta) posterior over an acceptable-output probability. Both shapes must be positive. */
interface BetaPosterior {
    readonly alpha: number;
    readonly beta: number;
}
/** A quality prior is the initial Beta posterior, the pseudo-counts before any evidence. */
type BetaPrior = BetaPosterior;
/** The label of a single quality judgment. */
type QualityLabel = 'accepted' | 'rejected';
/**
 * A Gamma(shape, rate) posterior over the rate parameter of an Exponential likelihood. A latency or a
 * cost observation `x > 0` is modeled as `x ~ Exponential(lambda)` with `lambda ~ Gamma(shape, rate)`;
 * the conjugate update adds one to `shape` and the observed value to `rate`. The expected value of the
 * Exponential, the mean latency or mean cost, is `1 / lambda`. Both parameters must be positive.
 */
interface GammaPosterior {
    readonly shape: number;
    readonly rate: number;
}
/** A latency or cost prior is the initial Gamma posterior. */
type GammaPrior = GammaPosterior;
/** An equal-tailed Bayesian credible interval. */
interface CredibleInterval {
    readonly lower: number;
    readonly upper: number;
    /** The mass inside the interval, for example 0.95. */
    readonly level: number;
}
/**
 * The observed outcome of one routed query. Quality is whether the output was acceptable; latency is
 * the wall-clock response time in milliseconds; cost is the token usage or money spent. Latency and
 * cost must be strictly positive (the Exponential likelihood has support on the open positive axis).
 */
interface Outcome {
    readonly quality: boolean | QualityLabel;
    readonly latencyMs: number;
    readonly cost: number;
}
/** The three conjugate posteriors carried by one (model, domain) arm. */
interface ArmPosterior {
    readonly quality: BetaPosterior;
    readonly latency: GammaPosterior;
    readonly cost: GammaPosterior;
}
/** The prior triple used to seed a fresh arm. */
interface ArmPrior {
    readonly quality: BetaPrior;
    readonly latency: GammaPrior;
    readonly cost: GammaPrior;
}
/** One persisted arm record: its posteriors plus observed counts and the last-observation time. */
interface ArmRecord {
    readonly model: string;
    readonly domain: string;
    readonly posterior: ArmPosterior;
    /** Total observed queries folded into the arm. */
    readonly pulls: number;
    /** Observed acceptable outputs. */
    readonly accepted: number;
    /** Observed unacceptable outputs. */
    readonly rejected: number;
    /** Epoch milliseconds of the last observation, for decay. */
    readonly lastObservedAt: number;
}
/** A calibrated point-and-interval summary of one arm, derived from its posteriors. */
interface ArmSummary {
    readonly model: string;
    readonly domain: string;
    /** Posterior mean acceptable-output probability. */
    readonly quality: number;
    readonly qualityInterval: CredibleInterval;
    /** Posterior mean latency in milliseconds. */
    readonly latencyMs: number;
    readonly latencyInterval: CredibleInterval;
    /** Posterior mean cost. */
    readonly cost: number;
    readonly costInterval: CredibleInterval;
    /** Expected utility computed from the posterior means under the configured weights. */
    readonly utility: number;
    readonly pulls: number;
}
/** Weights for the multi-objective utility. Higher quality is good; latency and cost are penalties. */
interface UtilityWeights {
    /** Weight on quality, the acceptable-output probability in [0, 1]. */
    readonly quality: number;
    /** Weight penalizing latency, applied to the normalized latency. */
    readonly latency: number;
    /** Weight penalizing cost, applied to the normalized cost. */
    readonly cost: number;
}
/** Reference scales that map latency (ms) and cost onto the same [0, 1]-ish scale as quality. */
interface UtilityScale {
    /** Reference latency in milliseconds. The latency penalty is `latencyMs / latencyScaleMs`. */
    readonly latencyMs: number;
    /** Reference cost. The cost penalty is `cost / costScale`. */
    readonly cost: number;
}
/** One arm's sampled draw during a single routing decision, kept for transparency. */
interface ArmDraw {
    readonly model: string;
    readonly domain: string;
    /** The Beta draw for quality. */
    readonly quality: number;
    /** The sampled expected latency in milliseconds (`1 / lambda`). */
    readonly latencyMs: number;
    /** The sampled expected cost (`1 / lambda`). */
    readonly cost: number;
    /** The expected utility of this draw. */
    readonly utility: number;
}
/** The result of routing one query. */
interface RouteDecision {
    readonly model: string;
    readonly domain: string;
    /** Every arm's draw this round, highest utility first. */
    readonly draws: ReadonlyArray<ArmDraw>;
    /** True when the safe-exploration guard let the Thompson pick differ from the greedy incumbent. */
    readonly explored: boolean;
}
/** The features the classifier reads to assign a query to a domain. */
interface QueryFeatures {
    /** The raw query text, if available. */
    readonly text?: string;
    /** An explicit domain override; when present, the default classifier returns it verbatim. */
    readonly domain?: string;
    /** Free-form tags that a custom classifier may key on. */
    readonly tags?: ReadonlyArray<string>;
    /** Input token count, if known. */
    readonly tokensIn?: number;
}
/** A classifier maps query features to a domain label. */
type QueryClassifier = (features: QueryFeatures) => string;
/** The composite key identifying one arm. */
interface ArmKey {
    readonly model: string;
    readonly domain: string;
}
/** A portable snapshot of an entire posterior store. */
interface StoreSnapshot {
    readonly version: 1;
    readonly arms: ReadonlyArray<ArmRecord>;
}
/** A pluggable posterior store keyed by (model, domain). The default is in-process memory. */
interface PosteriorStore {
    get(model: string, domain: string): ArmRecord | undefined;
    set(record: ArmRecord): void;
    keys(): ReadonlyArray<ArmKey>;
    snapshot(): StoreSnapshot;
}
/** Bounds on how far the Thompson pick may stray from the greedy incumbent, to cap regression risk. */
interface SafeExplorationPolicy {
    /** An arm with fewer than this many pulls is always allowed to be explored. */
    readonly minPulls: number;
    /**
     * The chosen arm's posterior-mean utility may be at most this far below the incumbent's. When the
     * Thompson pick violates the bound and is not under-explored, the router falls back to the incumbent.
     */
    readonly maxRegretMargin: number;
}
/** Options for time-decay of evidence, so old observations weigh less than recent ones. */
interface DecayOptions {
    /**
     * The half-life in milliseconds. At each decay step the pseudo-counts above the prior are scaled by
     * `0.5 ^ (elapsed / halfLifeMs)`, relaxing the posteriors back toward their priors.
     */
    readonly halfLifeMs: number;
}
/** The category of an audit entry. */
type AuditEventType = 'route' | 'observation' | 'note';
/** One append-only audit record. The hash chain is computed by sealing, not stored per entry. */
interface AuditEntry {
    readonly seq: number;
    readonly at: number;
    readonly type: AuditEventType;
    readonly summary: string;
    readonly data?: unknown;
}
/** An append-only audit log. */
interface AuditLog {
    readonly id: string;
    readonly entries: ReadonlyArray<AuditEntry>;
}
/** A tamper-evident seal over an {@link AuditLog}, a SHA-256 hash-chain root. */
interface AuditSeal {
    readonly algorithm: 'sha-256';
    readonly root: string;
    readonly count: number;
}
/** Result of verifying a sealed audit log. */
interface VerifyResult {
    readonly valid: boolean;
    readonly brokenAt?: number;
}

export type { ArmRecord as A, BetaPosterior as B, CredibleInterval as C, DecayOptions as D, GammaPosterior as G, Outcome as O, PosteriorStore as P, QualityLabel as Q, RouteDecision as R, StoreSnapshot as S, UtilityWeights as U, VerifyResult as V, UtilityScale as a, ArmSummary as b, ArmPrior as c, ArmPosterior as d, AuditLog as e, AuditEventType as f, AuditSeal as g, AuditEntry as h, BetaPrior as i, QueryFeatures as j, QueryClassifier as k, GammaPrior as l, SafeExplorationPolicy as m, ArmDraw as n, ArmKey as o, Clock as p };
