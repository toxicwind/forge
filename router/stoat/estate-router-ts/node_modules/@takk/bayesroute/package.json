    "bayesian",
    "llm-routing",
    "model-routing",
    "thompson-sampling",
    "multi-armed-bandit",
    "multi-objective",
    "cost-optimization",
    "exploration-exploitation",
    "conjugate-prior",
    "beta-bernoulli",
    "gamma-exponential",
    "credible-interval",
    "calibration",
    "regret-bound",
    "agent-orchestration",
    "model-selection",
    "edge",
    "openai",
    "anthropic",
    "llm",
    "zero-dependency",
    "typescript"
  ],
