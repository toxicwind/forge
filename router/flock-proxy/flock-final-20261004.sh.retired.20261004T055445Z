#!/usr/bin/env bash
# flock-final-20261004.sh — last 8000s, then apply.
set -uo pipefail
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RUN="$HOME/.flock-maxfix/final-$STAMP"
mkdir -p "$RUN"
LOG="$RUN/final.log"
: > "$LOG"
log(){ printf '%s\n' "$*" | tee -a "$LOG"; }
hdr(){ log ""; log "════════════════════════════════════════════════════════════════════"; log "$*"; log "════════════════════════════════════════════════════════════════════"; }

hdr "flock-final $STAMP — kill every remaining :8000, then apply patch.sh"

# 1. flock-final.sh — every 8000 in this file is stale nim-proxy residue.
F="$HOME/estate/ranch/flock/flock-final.sh"
if [ -f "$F" ]; then
  cp -a "$F" "$F.bak.$STAMP"
  log "  before: $(grep -cE '(^|[^0-9])8000([^0-9]|$)' "$F" 2>/dev/null | head -1) × 8000"
  sed -i -E 's/\b8000\b/25193/g' "$F"
  log "  after:"
  grep -nE '(^|[^0-9])8000([^0-9]|$)' "$F" | tee -a "$LOG" || log "    ✓ none"
  log "  25193 count: $(grep -c 25193 "$F" 2>/dev/null | head -1)"
fi

# 2. sysd-migrate-daemons.toml — only 8000s adjacent to NIM_PROXY / nim-proxy.
F="$HOME/estate/migration/staged/sysd-migrate-daemons.toml"
if [ -f "$F" ]; then
  cp -a "$F" "$F.bak.$STAMP"
  sed -i -E \
    -e 's/NIM_PROXY_PORT=8000/NIM_PROXY_PORT=25193/g' \
    -e 's/NIM_PROXY_PORT = "8000"/NIM_PROXY_PORT = "25193"/g' \
    -e 's#(\{\{ vars\.NIM_PROXY_PORT \}\}):8000#\1:25193#g' \
    "$F"
  log "  after:"
  grep -nE '(^|[^0-9])8000([^0-9]|$)' "$F" | tee -a "$LOG" || log "    ✓ none"
fi

# 3. patch.sh — fix the double-0 counting idiom.
P="$HOME/estate/ranch/mesh/proxy/flock-proxy/patch.sh"
if [ -f "$P" ]; then
  cp -a "$P" "$P.bak.$STAMP"
  python3 - "$P" <<'PYEOF'
import sys, pathlib, re
p = pathlib.Path(sys.argv[1])
s = p.read_text()
before = s
s = re.sub(
    r'n=\$\(grep -c ([^)]+?) 2>/dev/null \|\| echo 0\)',
    r'n=$(grep -c \1 2>/dev/null | head -1); n=${n:-0}',
    s,
)
s = re.sub(
    r'grep -c (\S+) "(\$f)" 2>/dev/null \|\| echo 0',
    r'grep -c \1 "\2" 2>/dev/null | head -1',
    s,
)
if s != before:
    p.write_text(s)
    print("  patched counting idiom")
else:
    print("  no counting idiom to patch (already clean)")
PYEOF
fi

# 4. Verify every live file with correct counting.
hdr "verify — live flock files"
ALL_CLEAN=1
for f in \
  "$HOME/estate/ranch/flock/flock-final.sh" \
  "$HOME/estate/ranch/flock/bin/flock-run.sh" \
  "$HOME/estate/ranch/estate-scripts-end4/dots/.bashrc.env" \
  "$HOME/estate/ranch/shell/ii/dots/.bashrc.env" \
  "$HOME/estate/migration/staged/sysd-migrate-daemons.toml" \
; do
  [ -f "$f" ] || { log "  (absent) $f"; continue; }
  n=$(grep -E '(^|[^0-9])8000([^0-9]|$)' "$f" 2>/dev/null | wc -l)
  m=$(grep -c '25193' "$f" 2>/dev/null | head -1); m=${m:-0}
  if [ "$n" -eq 0 ]; then
    log "  ✓  $f  (25193 × $m)"
  else
    log "  ✗  $n × 8000  $f"
    grep -nE '(^|[^0-9])8000([^0-9]|$)' "$f" | sed 's/^/       /' | tee -a "$LOG"
    ALL_CLEAN=0
  fi
done

if [ "$ALL_CLEAN" -eq 0 ]; then
  hdr "STOP — residual 8000 remains; patch.sh NOT applied"
  log "  inspect the ✗ lines above; re-run only after they're gone."
  exit 1
fi

# 5. APPLY patch.sh for real.
hdr "apply patch.sh"
timeout 300 bash "$P" --restart-flock 2>&1 | tee -a "$LOG"

# 6. :25193 final check
hdr "final :25193"
PID=$(ss -tlnpH 'sport = :25193' 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
if [ -n "$PID" ]; then
  log "  pid=$PID exe=$(readlink -f /proc/$PID/exe)"
  H1=$(sha256sum "/proc/$PID/exe" 2>/dev/null | awk '{print $1}')
  H2=$(sha256sum "$HOME/.flock/flock" 2>/dev/null | awk '{print $1}')
  if [ "$H1" = "$H2" ]; then log "  ✓ running == on-disk"; else log "  ✗ mismatch"; fi
else
  log "  no listener on :25193 — check pitchfork"
fi

# 7. Where the deprecated string lives.
hdr "all_stream_providers_exhausted — final location"
grep -rln 'all_stream_providers_exhausted' "$HOME/estate/ranch" 2>/dev/null \
  | grep -vE '/target/|/node_modules/|/\.git/|\.bak\.' \
  | tee -a "$LOG" || log "  (none)"

hdr "DONE — $LOG"
log ""
log "  canonical port: 25193"
log "  Rust flock is the :25193 owner (pid $PID)."
log "  TS/Py/estate-scripts/cuttinggate routers are bannered DEPRECATED."
log "  'all_stream_providers_exhausted' is TypeScript/Python-only — never from Rust flock."
