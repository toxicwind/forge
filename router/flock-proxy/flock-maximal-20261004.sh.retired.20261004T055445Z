#!/usr/bin/env bash
# flock-maximal-20261004.sh — correct comment stripping, verify, apply, restart, confirm.
set -uo pipefail
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RUN="$HOME/.flock-maxfix/maximal-$STAMP"
mkdir -p "$RUN"
LOG="$RUN/maximal.log"
: > "$LOG"
log(){ printf '%s\n' "$*" | tee -a "$LOG"; }
hdr(){ log ""; log "════════════════════════════════════════════════════════════════════"; log "$*"; log "════════════════════════════════════════════════════════════════════"; }

hdr "flock-maximal $STAMP"

# ── 0. Canonical detector: strip trailing comments too.
#    Rule: remove everything from the first unquoted '#' to EOL.
#    None of our five files embed '#' inside strings, so a plain sed is safe.
strip_comments(){ sed -E 's/#.*$//' "$1" 2>/dev/null; }

count_live_8000(){
  # number of 8000s that appear BEFORE any '#' on a line
  strip_comments "$1" | grep -cE '(^|[^0-9])8000([^0-9]|$)' 2>/dev/null | head -1
}

# ── 1. Verify every live file.
hdr "verify — 8000 outside comments only"
ALL_CLEAN=1
for f in \
  "$HOME/estate/ranch/flock/flock-final.sh" \
  "$HOME/estate/ranch/flock/bin/flock-run.sh" \
  "$HOME/estate/ranch/estate-scripts-end4/dots/.bashrc.env" \
  "$HOME/estate/ranch/shell/ii/dots/.bashrc.env" \
  "$HOME/estate/migration/staged/sysd-migrate-daemons.toml" \
; do
  [ -f "$f" ] || { log "  (absent) $f"; continue; }
  n=$(count_live_8000 "$f"); n=${n:-0}
  c=$(grep -cE '(^|[^0-9])8000([^0-9]|$)' "$f" 2>/dev/null | head -1); c=${c:-0}
  m=$(grep -c '25193' "$f" 2>/dev/null | head -1); m=${m:-0}
  if [ "$n" -eq 0 ]; then
    log "  ✓  $f  (25193 × $m; 8000 total × $c, all inside comments)"
  else
    log "  ✗  $n live × 8000  $f"
    strip_comments "$f" \
      | grep -nE '(^|[^0-9])8000([^0-9]|$)' | sed 's/^/       /' | tee -a "$LOG"
    ALL_CLEAN=0
  fi
done

if [ "$ALL_CLEAN" -eq 0 ]; then
  hdr "STOP — live 8000 remains; patch.sh NOT applied"
  exit 1
fi

# ── 2. Apply patch.sh with restart.
P="$HOME/estate/ranch/mesh/proxy/flock-proxy/patch.sh"
hdr "apply patch.sh --restart-flock"
timeout 300 bash "$P" --restart-flock 2>&1 | tee -a "$LOG"

# ── 3. :25193 confirm.
hdr "final :25193"
PID=$(ss -tlnpH 'sport = :25193' 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
if [ -n "$PID" ]; then
  log "  pid=$PID exe=$(readlink -f /proc/$PID/exe)"
  H1=$(sha256sum "/proc/$PID/exe" 2>/dev/null | awk '{print $1}')
  H2=$(sha256sum "$HOME/.flock/flock" 2>/dev/null | awk '{print $1}')
  if [ "$H1" = "$H2" ]; then log "  ✓ running == on-disk"; else log "  ✗ mismatch"; fi
else
  log "  no listener on :25193 — check pitchfork"
fi

# ── 4. Deprecated string location.
hdr "all_stream_providers_exhausted — final location"
grep -rln 'all_stream_providers_exhausted' "$HOME/estate/ranch" 2>/dev/null \
  | grep -vE '/target/|/node_modules/|/\.git/|\.bak\.' \
  | tee -a "$LOG" || log "  (none)"

# ── 5. Flock health probe.
hdr "flock health"
KEY="${FLOCK_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$HOME/.secrets" ]; then
  KEY=$(grep -m1 '^FLOCK_API_KEY=' "$HOME/.secrets" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"'')
fi
log "  key prefix: ${KEY:0:14}…"
curl -sS -i --max-time 5 http://127.0.0.1:25193/health 2>&1 | tee -a "$LOG"
log ""
log "  /v1/models:"
curl -sS -i --max-time 10 -H "Authorization: Bearer $KEY" \
  http://127.0.0.1:25193/v1/models 2>&1 | head -20 | tee -a "$LOG"

hdr "DONE — $LOG"
log ""
log "  canonical port: 25193"
log "  Rust flock is the :25193 owner (pid $PID)."
log "  TS/Py/estate-scripts/cuttinggate routers are bannered DEPRECATED."
log "  'all_stream_providers_exhausted' is TS/Python-only — never from Rust flock."
