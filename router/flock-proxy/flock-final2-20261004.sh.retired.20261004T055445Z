#!/usr/bin/env bash
# flock-final2 — resume from where we stopped: only verify + apply.
set -uo pipefail
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RUN="$HOME/.flock-maxfix/final2-$STAMP"
mkdir -p "$RUN"
LOG="$RUN/final2.log"
: > "$LOG"
log(){ printf '%s\n' "$*" | tee -a "$LOG"; }
hdr(){ log ""; log "════════════════════════════════════════════════════════════════════"; log "$*"; log "════════════════════════════════════════════════════════════════════"; }

hdr "flock-final2 $STAMP"

# Verify: count 8000 only on non-comment lines. A comment for our purposes
# is any line whose first non-whitespace character is '#'. For .toml, same.
# For .env/.sh, same. This is conservative — a live 8000 in a value would
# still be caught because it appears before any '#'.

hdr "verify — live 8000 refs (comments excluded)"
ALL_CLEAN=1
for f in \
  "$HOME/estate/ranch/flock/flock-final.sh" \
  "$HOME/estate/ranch/flock/bin/flock-run.sh" \
  "$HOME/estate/ranch/estate-scripts-end4/dots/.bashrc.env" \
  "$HOME/estate/ranch/shell/ii/dots/.bashrc.env" \
  "$HOME/estate/migration/staged/sysd-migrate-daemons.toml" \
; do
  [ -f "$f" ] || { log "  (absent) $f"; continue; }

  # strip lines whose first non-space char is '#', then count 8000
  n=$(grep -vE '^[[:space:]]*#' "$f" 2>/dev/null \
      | grep -E '(^|[^0-9])8000([^0-9]|$)' 2>/dev/null | wc -l)
  # also count commented 8000s separately for visibility
  nc=$(grep -E '^[[:space:]]*#' "$f" 2>/dev/null \
       | grep -cE '(^|[^0-9])8000([^0-9]|$)' 2>/dev/null | head -1); nc=${nc:-0}
  m=$(grep -c '25193' "$f" 2>/dev/null | head -1); m=${m:-0}

  if [ "$n" -eq 0 ]; then
    log "  ✓  $f  (25193 × $m; 8000 in comments × $nc — OK)"
  else
    log "  ✗  $n live × 8000  $f"
    grep -vE '^[[:space:]]*#' "$f" \
      | grep -nE '(^|[^0-9])8000([^0-9]|$)' | sed 's/^/       /' | tee -a "$LOG"
    ALL_CLEAN=0
  fi
done

if [ "$ALL_CLEAN" -eq 0 ]; then
  hdr "STOP — a live (non-comment) 8000 exists; patch.sh NOT applied"
  exit 1
fi

# Apply.
P="$HOME/estate/ranch/mesh/proxy/flock-proxy/patch.sh"
hdr "apply patch.sh --restart-flock"
timeout 300 bash "$P" --restart-flock 2>&1 | tee -a "$LOG"

# :25193 confirm.
hdr "final :25193"
PID=$(ss -tlnpH 'sport = :25193' 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
if [ -n "$PID" ]; then
  log "  pid=$PID exe=$(readlink -f /proc/$PID/exe)"
  H1=$(sha256sum "/proc/$PID/exe" 2>/dev/null | awk '{print $1}')
  H2=$(sha256sum "$HOME/.flock/flock" 2>/dev/null | awk '{print $1}')
  if [ "$H1" = "$H2" ]; then log "  ✓ running == on-disk"; else log "  ✗ mismatch"; fi
else
  log "  no listener on :25193 — check pitchfork"
fi

# Where the deprecated string lives.
hdr "all_stream_providers_exhausted — final location"
grep -rln 'all_stream_providers_exhausted' "$HOME/estate/ranch" 2>/dev/null \
  | grep -vE '/target/|/node_modules/|/\.git/|\.bak\.' \
  | tee -a "$LOG" || log "  (none)"

hdr "DONE — $LOG"
log ""
log "  canonical port: 25193"
log "  Rust flock is the :25193 owner (pid $PID)."
log "  TS/Py/estate-scripts/cuttinggate routers are bannered DEPRECATED."
log "  'all_stream_providers_exhausted' is TS/Python-only — never from Rust flock."
