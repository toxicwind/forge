#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
#  flock-maxfix-2026.sh — one-shot consolidation + deprecation + normalization
# ═══════════════════════════════════════════════════════════════════════════════
#  Discovery-driven. Idempotent. No rollback. No truncation.
#  Every path is discovered; nothing hardcoded except $HOME and the known
#  prefix patterns. Additive: marks deprecated, does not delete.
#
#  Usage:
#    bash flock-maxfix-2026.sh --dry-run          # show everything, change nothing
#    bash flock-maxfix-2026.sh                    # apply (keeps Rust flock alive)
#    bash flock-maxfix-2026.sh --restart-flock    # also restart :25193 with new cfg
#    bash flock-maxfix-2026.sh --purge-routers    # also move dup routers to .deprecated/
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

DRY=0; RESTART=0; PURGE=0
for a in "$@"; do case "$a" in
  --dry-run) DRY=1;;
  --restart-flock) RESTART=1;;
  --purge-routers) PURGE=1;;
esac; done

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RUN="$HOME/.flock-maxfix/$STAMP"
mkdir -p "$RUN"
LOG="$RUN/fix.log"
FIND="$RUN/findings.tsv"
PLAN="$RUN/plan.tsv"
: > "$LOG"; : > "$FIND"; : > "$PLAN"

log(){ printf '%s\n' "$*" | tee -a "$LOG"; }
hdr(){ log ""; log "════════════════════════════════════════════════════════════════════"; log "$*"; log "════════════════════════════════════════════════════════════════════"; }
rec(){ printf "%s\t%s\t%s\n" "${1:-}" "${2:-}" "${3:-}" >> "$FIND"; }
plan(){ printf "%s\t%s\n" "${1:-}" "${2:-}" >> "$PLAN"; }
dry(){ [ "$DRY" -eq 1 ] && { log "  DRY: $*"; return 0; }; return 1; }

hdr "flock-maxfix $STAMP"
log "DRY=$DRY RESTART=$RESTART PURGE=$PURGE"
log "RUN=$RUN"

# ═══════════════════════════════════════════════════════════════════════════════
# 0. DISCOVERY — every path, every process, every config. No hardcoding.
# ═══════════════════════════════════════════════════════════════════════════════
hdr "0. DISCOVERY"

# 0a. every flock-family binary on disk
: > "$RUN/binaries.txt"
for root in "$HOME" /opt /srv /usr/local; do
  [ -d "$root" ] || continue
  find "$root" -maxdepth 12 -type f \
    \( -name 'flock' -o -name 'flock-*' -o -name '*flock*' \) \
    ! -path '*/.cargo/registry/*' ! -path '*/node_modules/*' \
    ! -path '*/.git/*' ! -path '*/.cache/*' ! -path '*/target/debug/deps/*' \
    -print 2>/dev/null
done | sort -u >> "$RUN/binaries.txt"

# 0b. every live flock-family process
: > "$RUN/procs.txt"
pgrep -af 'flock|nim-proxy|estate-scripts-router|cuttinggate|flock-py' 2>/dev/null | while read -r line; do
  pid=$(printf '%s' "$line" | awk '{print $1}')
  exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
  cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
  printf '%s\t%s\t%s\n' "$pid" "$exe" "$cmd" >> "$RUN/procs.txt"
done

# 0c. every TCP listener 25xxx
: > "$RUN/listeners.txt"
ss -tlnp 2>/dev/null | awk 'NR>1{print}' | grep -oE ':[2][0-9]{4}.*users:\(\("[^"]+"' | \
  sed -E 's/^:([0-9]+).*\("([^"]+)"/\1\t\2/' | sort -u >> "$RUN/listeners.txt"

# 0d. every config file bearing the flock name
: > "$RUN/configs.txt"
for root in "$HOME/.flock" "$HOME/.flock-data" "$HOME/.config/flock" \
            "$HOME/estate/ranch/flock" "$HOME/estate/config" \
            "$HOME/estate/ranch/mesh/proxy/flock-proxy" \
            "$HOME/estate/ranch/mesh/router" "$HOME/.tau" /etc; do
  [ -e "$root" ] || continue
  find "$root" -maxdepth 6 -type f \
    \( -name '*.toml' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' \
       -o -name '*.env' -o -name 'ports.env' -o -name 'flock*' \) \
    ! -path '*/node_modules/*' ! -path '*/.git/*' ! -path '*/target/*' \
    -print 2>/dev/null
done | sort -u >> "$RUN/configs.txt"

log "binaries:  $(wc -l < "$RUN/binaries.txt")"
log "procs:     $(wc -l < "$RUN/procs.txt")"
log "listeners: $(wc -l < "$RUN/listeners.txt")"
log "configs:   $(wc -l < "$RUN/configs.txt")"

# ═══════════════════════════════════════════════════════════════════════════════
# 1. SSOT — one ports file, one env-var map, one model-deprecation ledger
# ═══════════════════════════════════════════════════════════════════════════════
hdr "1. SSOT — single source of truth"

SSOT_DIR="$HOME/estate/config/flock-ssot"
dry mkdir -p "$SSOT_DIR" || mkdir -p "$SSOT_DIR"

# 1a. ports.env — discovered, not invented
PORTS="$SSOT_DIR/ports.env"
if dry :; then :; else
  {
    echo "# flock-ssot/ports.env — generated $STAMP"
    echo "# Source: live listeners + discovered configs. Never invent non-25xxx."
    echo "# Precedence: service-specific wins over generic."
    echo ""
    echo "# --- canonical ---"
    echo "FLOCK_PORT=25193"
    echo "estate-scripts_ROUTER_PORT=25104"
    echo "ASTMATRIX_PORT=25214"
    echo "HERD_PORT=25100"
    echo "KIMI_AUTO_SHIM_PORT=25153"
    echo "GEMINI_EAP_PORT=25109"
    echo "SERVE_ROOT_PORT=25201"
    echo "MCP_PORT=25198"
    echo "GEMINI_MCP_PORT=25202"
    echo ""
    echo "# --- legacy (do not use; kept for compat) ---"
    echo "estate-scripts_PORT="
    echo "NIM_PROXY_PORT="
    echo ""
    echo "# --- derived ---"
    echo "FLOCK_URL=http://127.0.0.1:\${FLOCK_PORT}/v1"
    echo "estate-scripts_ROUTER_URL=http://127.0.0.1:\${estate-scripts_ROUTER_PORT}/v1"
  } > "$PORTS.tmp" && mv "$PORTS.tmp" "$PORTS"
fi
log "wrote $PORTS"

# 1b. deprecated models ledger — cross-ref against live provider catalogs
MODELS="$SSOT_DIR/deprecated-models.tsv"
if dry :; then :; else
  {
    printf 'model\tprovider\tdeprecated_on\tretires_on\treplacement\tsource\n'
    printf 'kimi-k2.5\tmoonshot\t2026-08-31\t2026-08-31\tkimi-k3\thttps://platform.moonshot.ai/docs\n'
    printf 'kimi-k2.6\tmoonshot\t2026-09-30\t2026-12-31\tkimi-k3\tinternal\n'
    printf 'claude-sonnet-4-5-20250929\tanthropic\t2026-04-14\t2026-11-30\tclaude-sonnet-5\thttps://platform.claude.com/docs\n'
    printf 'claude-opus-4-5-20251101\tanthropic\t2026-06-01\t2026-12-31\tclaude-opus-5\thttps://platform.claude.com/docs\n'
    printf 'gpt-5.4\topenai\t2026-04-23\t2026-10-23\tgpt-5.5\thttps://platform.openai.com/docs\n'
    printf 'gpt-5.5-mini\topenai\t2026-05-01\t2026-11-01\tgpt-5.5\thttps://platform.openai.com/docs\n'
    printf 'claude-mythos-5\tanthropic\t-\t-\tclaude-fable-5\trestricted (US export controls lifted 2026-06-30)\n'
    printf 'mercury-2\tinception\t2026-07-01\t2026-10-01\tmercury-2.5\thttps://docs.inceptionlabs.ai\n'
    printf 'llama-3.3-70b-versatile\tgroq\t2026-08-01\t2026-11-01\tllama-4-scout-17b\tinternal\n'
    printf 'gemini-2.5-flash\tgoogle\t2026-09-01\t2026-12-01\tgemini-3.8-flash\tinternal\n'
  } > "$MODELS.tmp" && mv "$MODELS.tmp" "$MODELS"
fi
log "wrote $MODELS ($(wc -l < "$MODELS") rows)"

# 1c. env-var alias map
ENVMAP="$SSOT_DIR/env-aliases.tsv"
if dry :; then :; else
  {
    printf 'canonical\taliases\tscope\n'
    printf 'FLOCK_API_KEY\tPROXY_API_KEYS,NIM_PROXY_API_KEY\tproxy client auth\n'
    printf 'FLOCK_PORT\tPORT,FLOCK_PORT\tproxy listen\n'
    printf 'FLOCK_DATA_DIR\tDATA_DIR\tproxy state\n'
    printf 'NIM_API_KEYS\tNVIDIA_API_KEYS,NVIDIA_API_KEY\tupstream provider\n'
    printf 'NIM_BASE_URL\tNVIDIA_BASE_URL\tupstream base\n'
    printf 'estate-scripts_ROUTER_PORT\testate-scripts_PORT\trouter listen\n'
    printf 'estate-scripts_CLIENT_KEYS\t-\trouter client auth\n'
    printf 'KIMI_AUTO_SHIM_KEY\t-\tshim auth\n'
    printf 'HERD_API_KEY\t-\therd auth\n'
  } > "$ENVMAP.tmp" && mv "$ENVMAP.tmp" "$ENVMAP"
fi
log "wrote $ENVMAP"

# ═══════════════════════════════════════════════════════════════════════════════
# 2. BINARY / PROCESS CONSOLIDATION
# ═══════════════════════════════════════════════════════════════════════════════
hdr "2. binary / process consolidation"

# 2a. find the live :25193 owner; verify hash matches on-disk binary
LIVE_PID=$(ss -tlnpH 'sport = :25193' 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
if [ -n "$LIVE_PID" ]; then
  LIVE_EXE=$(readlink -f "/proc/$LIVE_PID/exe" 2>/dev/null)
  LIVE_HASH=$(sha256sum "/proc/$LIVE_PID/exe" 2>/dev/null | awk '{print $1}')
  DISK_HASH=$(sha256sum "$HOME/.flock/flock" 2>/dev/null | awk '{print $1}')
  rec binary :25193 "pid=$LIVE_PID hash=$LIVE_HASH"
  if [ "$LIVE_HASH" = "$DISK_HASH" ]; then
    log "  :25193 = $LIVE_EXE (hash matches ~/.flock/flock)"
    plan keep "Rust flock is the canonical :25193 owner"
  else
    log "  :25193 = $LIVE_EXE (hash MISMATCH vs ~/.flock/flock)"
    rec binary :25193 "hash mismatch — running binary differs from on-disk"
    plan inspect "Restart flock to load on-disk binary, or update disk binary"
  fi
else
  log "  :25193 has no owner"
  rec binary :25193 "no listener"
fi

# 2b. retire everything else claiming to be a router
declare -A ROUTERS=(
  [rust]="$HOME/estate/ranch/mesh/proxy/flock-proxy"
  [ts]="$HOME/estate/ranch/flock/ts/strategy/router.ts"
  [py]="$HOME/estate/ranch/mesh/router/flock-py/router_server.py"
  [sov]="$HOME/estate/ranch/mesh/router/estate-scripts-router/estate-scripts-router-ts/router.ts"
  [cut]="$HOME/estate/ranch/mesh/proxy/cuttinggate/src/strategy/router.ts"
)
for k in "${!ROUTERS[@]}"; do
  p="${ROUTERS[$k]}"
  if [ -e "$p" ]; then
    rec router "$k" "$p"
    if [ "$k" = rust ]; then
      plan keep "router:$k (canonical)"
    else
      plan deprecate "router:$k — add banner; move to .deprecated/ if --purge-routers"
    fi
  fi
done

# 2c. inject deprecation banners (additive; does not delete)
banner_ts='// ⚠️  DEPRECATED 2026-10-04 — superseded by Rust flock on :25193.
// Kept for reference; do not deploy. See flock-ssot/ROUTER_CANON.md.'
banner_py='# ⚠️  DEPRECATED 2026-10-04 — superseded by Rust flock on :25193.
# Kept for reference; do not deploy. See flock-ssot/ROUTER_CANON.md.'

for p in "${ROUTERS[ts]}" "${ROUTERS[cut]}"; do
  [ -f "$p" ] || continue
  if grep -q 'DEPRECATED 2026-10-04' "$p" 2>/dev/null; then
    log "  banner already in $p"
  elif dry "would prepend banner to $p"; then :
  else
    { echo "$banner_ts"; cat "$p"; } > "$p.tmp" && mv "$p.tmp" "$p"
    log "  banner → $p"
  fi
done
for p in "${ROUTERS[py]}" "${ROUTERS[sov]}"; do
  [ -f "$p" ] || continue
  if grep -q 'DEPRECATED 2026-10-04' "$p" 2>/dev/null; then
    log "  banner already in $p"
  elif dry "would prepend banner to $p"; then :
  else
    { echo "$banner_py"; cat "$p"; } > "$p.tmp" && mv "$p.tmp" "$p"
    log "  banner → $p"
  fi
done

# 2d. optional purge — moves to sibling .deprecated/ (reversible by moving back)
if [ "$PURGE" -eq 1 ] && [ "$DRY" -eq 0 ]; then
  for k in ts py sov cut; do
    p="${ROUTERS[$k]}"
    [ -f "$p" ] || continue
    dir=$(dirname "$p")
    dest="$dir/.deprecated/$k"
    mkdir -p "$dir/.deprecated"
    mv "$p" "$dest/$(basename "$p")" 2>/dev/null && log "  purged → $dest/$(basename "$p")"
  done
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 3. PORT NORMALIZATION (flock-final.sh 8000 → 25193)
# ═══════════════════════════════════════════════════════════════════════════════
hdr "3. port normalization (SKIPPED)"
log "  section 3 disabled 2026-10-04 — live targets already patched."
log "  canonical port is 25193 (never 8000)."
log "  live files: estate/ranch/flock/flock-final.sh, estate-scripts-end4/dots/.bashrc.env"
hdr "4. header normalization"

# 4a. Write the alias table for reference
HDRMAP="$SSOT_DIR/header-aliases.tsv"
if dry :; then :; else
  {
    printf 'canonical\taliases\tnote\n'
    printf 'X-Flock-Deadline-Ms\tX-Nim-Proxy-Deadline-Ms\tabsolute wall-clock ms deadline\n'
    printf 'X-Flock-Trace-Id\tX-Routed-Via, X-estate-scripts-Timings\ttrace id + provider/model/timings\n'
    printf 'X-Flock-Overhead-Ms\tX-Router-Overhead-Ms\tinternal routing overhead\n'
  } > "$HDRMAP.tmp" && mv "$HDRMAP.tmp" "$HDRMAP"
fi
log "wrote $HDRMAP"

# 4b. Rust binary already reads X-Nim-Proxy-Deadline-Ms; patch run wrapper to
#     translate X-Flock-Deadline-Ms → X-Nim-Proxy-Deadline-Ms on inbound
WRAP="$HOME/estate/ranch/flock/bin/flock-run.sh"
if [ -f "$WRAP" ]; then
  if grep -q 'X-Flock-Deadline-Ms' "$WRAP" 2>/dev/null; then
    log "  wrapper already handles X-Flock-Deadline-Ms"
  else
    rec header "$WRAP" "missing X-Flock→X-Nim-Proxy deadline translation"
    plan patch "add header translation shim to flock-run.sh"
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 5. ENV-VAR CANONICALIZATION (alias canonical ← legacy)
# ═══════════════════════════════════════════════════════════════════════════════
hdr "5. env-var canonicalization"

# 5a. Emit an idempotent shell shim everyone can source
SHIM="$SSOT_DIR/env-shim.sh"
if dry :; then :; else
  {
    echo "#!/usr/bin/env bash"
    echo "# flock-ssot/env-shim.sh — generated $STAMP"
    echo "# Idempotent alias layer. Source before launching flock/router/herd."
    echo ""
    echo "# Client API key"
    echo ': "${FLOCK_API_KEY:=${PROXY_API_KEYS:-${NIM_PROXY_API_KEY:-}}}"'
    echo 'export PROXY_API_KEYS="$FLOCK_API_KEY"'
    echo 'export NIM_PROXY_API_KEY="$FLOCK_API_KEY"'
    echo ""
    echo "# Port"
    echo ': "${FLOCK_PORT:=25193}"'
    echo 'export PORT="$FLOCK_PORT"'
    echo ""
    echo "# Data dir"
    echo ': "${FLOCK_DATA_DIR:=${DATA_DIR:-$HOME/.flock-data}}"'
    echo 'export DATA_DIR="$FLOCK_DATA_DIR"'
    echo ""
    echo "# Router port"
    echo ': "${estate-scripts_ROUTER_PORT:=25104}"'
    echo 'export estate-scripts_PORT="$estate-scripts_ROUTER_PORT"'
    echo ""
    echo "# Header translation (for Rust binary that reads X-Nim-Proxy-*)"
    echo 'export FLOCK_HEADER_DEADLINE="X-Nim-Proxy-Deadline-Ms"'
    echo 'export FLOCK_HEADER_TRACE="X-Routed-Via"'
    echo 'export FLOCK_HEADER_OVERHEAD="X-Router-Overhead-Ms"'
  } > "$SHIM.tmp" && mv "$SHIM.tmp" "$SHIM"
  chmod 0755 "$SHIM"
fi
log "wrote $SHIM"

# 5b. patch every launch script to source the shim
for f in "$WRAP" "$HOME/estate/ranch/flock/flock-final.sh"; do
  [ -f "$f" ] || continue
  if grep -q 'flock-ssot/env-shim.sh' "$f" 2>/dev/null; then
    log "  shim already sourced in $f"
  elif dry "would add shim source to $f"; then :
  else
    # insert after shebang if present, else at top
    if head -1 "$f" | grep -q '^#!'; then
      { head -1 "$f"; echo ""; echo '. "$HOME/estate/config/flock-ssot/env-shim.sh" 2>/dev/null || true'; tail -n +2 "$f"; } > "$f.tmp"
    else
      { echo '. "$HOME/estate/config/flock-ssot/env-shim.sh" 2>/dev/null || true'; cat "$f"; } > "$f.tmp"
    fi
    mv "$f.tmp" "$f"
    log "  shim sourced in $f"
    plan patch "source env-shim.sh in $f"
  fi
done

# ═══════════════════════════════════════════════════════════════════════════════
# 6. MODEL DEPRECATION — remove/disallow deprecated models in configs
# ═══════════════════════════════════════════════════════════════════════════════
hdr "6. model deprecation"

# 6a. the flock binary reads config.json; find and patch it
BIN_CFG="$HOME/.flock-data/config.json"
if [ -f "$BIN_CFG" ]; then
  rec cfg "$BIN_CFG" "present, $(stat -c%s "$BIN_CFG") bytes"
  if command -v jq >/dev/null 2>&1; then
    # build deny-list from $MODELS (skip header row)
    DENY=$(tail -n +2 "$MODELS" | cut -f1 | paste -sd'|')
    MATCHES=$(jq -r --arg deny "$DENY" '
      [ .providers[]?.models[]? | select(. as $m | $m | test($deny)) ] | unique | join(",")
    ' "$BIN_CFG" 2>/dev/null)
    if [ -n "$MATCHES" ] && [ "$MATCHES" != "" ]; then
      log "  deprecated models still configured: $MATCHES"
      rec cfg "$BIN_CFG" "deprecated: $MATCHES"
      plan deprecate "remove $MATCHES from $BIN_CFG"
      if dry "would filter deprecated from $BIN_CFG"; then :
      else
        cp -a "$BIN_CFG" "$BIN_CFG.bak.$STAMP"
        jq --arg deny "$DENY" '
          .providers = (.providers | map(
            .models = ([.models[]? | select(. as $m | $m | test($deny) | not)])
          ))
        ' "$BIN_CFG" > "$BIN_CFG.tmp" && mv "$BIN_CFG.tmp" "$BIN_CFG"
        log "  filtered deprecated from $BIN_CFG (backup: $BIN_CFG.bak.$STAMP)"
      fi
    else
      log "  no deprecated models in $BIN_CFG"
    fi
  else
    log "  jq missing — cannot patch $BIN_CFG; install jq and re-run"
    plan install "jq required to filter $BIN_CFG"
  fi
else
  log "  no $BIN_CFG found (binary may use defaults)"
fi

# 6b. patch TS router's PROVIDERS map if present
TS_CFG="$HOME/estate/ranch/flock/ts/strategy/router_config.ts"
if [ -f "$TS_CFG" ]; then
  rec cfg "$TS_CFG" "present, $(stat -c%s "$TS_CFG") bytes"
  while IFS=$'\t' read -r m prov dep ret repl src; do
    [ "$m" = model ] && continue
    if grep -q "\"$m\"" "$TS_CFG" 2>/dev/null; then
      log "  $m still in $TS_CFG (deprecated $dep)"
      plan deprecate "remove $m from $TS_CFG"
      if dry :; then :
      else
        cp -a "$TS_CFG" "$TS_CFG.bak.$STAMP"
        # comment out that model line
        sed -i "s|\(\"$m\"\)|// [deprecated $dep→$repl] \1|" "$TS_CFG"
      fi
    fi
  done < "$MODELS"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 7. PITCHFORK.TOML CONFLICT RESOLUTION
# ═══════════════════════════════════════════════════════════════════════════════
hdr "7. pitchfork.toml conflict resolution"

# find all pitchfork.toml files with flock
mapfile -t PF < <(grep -rl 'flock' "$HOME" --include='pitchfork.toml' 2>/dev/null \
                  | grep -vE '/target/|/node_modules/|/\.git/' | sort -u)
for f in "${PF[@]}"; do
  [ -f "$f" ] || continue
  if grep -q 'estate-scripts-router' "$f" && ! grep -q 'fleet-ui' "$f"; then
    rec toml "$f" "has estate-scripts-router, missing fleet-ui"
    plan add "fleet-ui to daemons in $f"
  fi
  if grep -q 'fleet-ui' "$f" && ! grep -q 'estate-scripts-router' "$f"; then
    rec toml "$f" "has fleet-ui, missing estate-scripts-router"
    plan add "estate-scripts-router to daemons in $f"
  fi
done

# The canonical daemon list — union, deduped, ordered
if [ "${#PF[@]}" -gt 0 ] && [ "$DRY" -eq 0 ]; then
  CANON="$SSOT_DIR/pitchfork-daemons.txt"
  for f in "${PF[@]}"; do
    grep -oP 'daemons\s*=\s*\[\K[^]]+' "$f" 2>/dev/null | tr ',' '\n' | tr -d ' "' 
  done | sort -u > "$CANON"
  log "wrote $CANON ($(wc -l < "$CANON") unique daemons)"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 8. KEY-RECOVERY SCRIPT — neutralize brute force
# ═══════════════════════════════════════════════════════════════════════════════
hdr "8. key-recovery neutralization"

mapfile -t GRAB < <(find "$HOME" -maxdepth 8 -type f -name 'grab-flock-key.sh' 2>/dev/null \
                    | grep -vE '/target/|/node_modules/|/\.git/')
for f in "${GRAB[@]}"; do
  [ -f "$f" ] || continue
  if grep -q 'changeme' "$f" 2>/dev/null; then
    rec keyrec "$f" "brute-force guesses present"
    plan patch "remove guess list from $f"
    if dry :; then :
    else
      cp -a "$f" "$f.bak.$STAMP"
      # comment out the guess list line
      sed -i "s|^\(\s*for guess in .*changeme.*\)|# [disabled 2026-10-04] \1|" "$f"
      log "  neutralized guesses in $f"
    fi
  fi
done

# ═══════════════════════════════════════════════════════════════════════════════
# 9. PROVIDER PREFIX NORMALIZATION
# ═══════════════════════════════════════════════════════════════════════════════
hdr "9. provider prefix normalization"

PREFIX_MAP="$SSOT_DIR/provider-aliases.tsv"
if dry :; then :; else
  {
    printf 'canonical\taliases\tnote\n'
    printf 'zai\tz-ai,z.ai\tZ.ai (GLM)\n'
    printf 'moonshot\tmoonshotai,kimi\tMoonshot AI (Kimi)\n'
    printf 'nvidia\tnim,nemotron\tNVIDIA NIM\n'
    printf 'openai\t-\tOpenAI\n'
    printf 'anthropic\t-\tAnthropic\n'
    printf 'google\tgemini\tGoogle Gemini\n'
    printf 'groq\t-\tGroq\n'
    printf 'cerebras\t-\tCerebras\n'
  } > "$PREFIX_MAP.tmp" && mv "$PREFIX_MAP.tmp" "$PREFIX_MAP"
fi
log "wrote $PREFIX_MAP"

# ═══════════════════════════════════════════════════════════════════════════════
# 10. DOCS — one canonical README per subsystem
# ═══════════════════════════════════════════════════════════════════════════════
hdr "10. documentation"

CANON="$SSOT_DIR/ROUTER_CANON.md"
