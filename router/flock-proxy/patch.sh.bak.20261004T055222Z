# ═══════════════════════════════════════════════════════════════════════════════
# 11. RESTART (optional) — reload flock with new config
# ═══════════════════════════════════════════════════════════════════════════════
hdr "11. restart (optional)"

if [ "$RESTART" -eq 1 ] && [ "$DRY" -eq 0 ]; then
  if [ -n "${LIVE_PID:-}" ]; then
    log "  sending SIGHUP to $LIVE_PID (graceful reload if supported)"
    kill -HUP "$LIVE_PID" 2>/dev/null || true
    sleep 2
    if kill -0 "$LIVE_PID" 2>/dev/null; then
      log "  pid $LIVE_PID still alive; config may reload in place"
    else
      log "  pid $LIVE_PID exited; consider restarting via pitchfork"
      plan restart "pitchfork restart flock"
    fi
  fi
else
  log "  skipped (pass --restart-flock to reload)"
fi

