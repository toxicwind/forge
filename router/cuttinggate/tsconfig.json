{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "bun"]
  },
  // `src/*.ts` typechecked only the top level: src/router/, src/auth/ and the
  // tests were never compiled, so ten unresolved imports (../shared,
  // ../policy/*, ../../roost/*) reported zero errors. Recursive globs are the
  // whole point of the check.
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
