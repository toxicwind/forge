# 50-secrets — credential material is never committed.
# LAST layer on purpose: no earlier negation can re-include anything below.
# Enforced twice: here (untracked files) and by the global gitleaks hooks in
# ops/git-hooks/ (anything staged or pushed, in every repo on the box).
.env
.env.*
!.env.example
*.env
!.env
!.envrc
# re-ignore credential envs the !.env negation would resurrect at depth:
config/tau/.env
config/**/.env
!config/ports.env
!config/hodos-ssot/route.env
.secrets
.secrets.*
.corral-*-env
*keys_raw*
nvapi_audit_summary.json
auth.json
*.token
id_rsa*
id_ed25519*
*.p12
*.pfx

# Runtime/garbage artifacts that must never be committed
/dump.rdb
dump.rdb
hf-downloader/

# Large report tarballs - not tracked (GitHub 100MB limit)
config/tau/reports/*.tar.gz

# Credential backups - never tracked
config/tau/agent/auth.json.bak*

# RustDesk server keypair — private key must never be committed
estate/ranch/rustdesk-server/id_ed25519
estate/ranch/rustdesk-server/id_ed25519.pub
ranch/rustdesk-server/id_ed25519
ranch/rustdesk-server/id_ed25519.pub
